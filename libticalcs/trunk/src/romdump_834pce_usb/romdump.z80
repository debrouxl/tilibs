;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

ProtProgObj      = 6
_Mov9ToOP1       = 0x0020320
_ChkFindSym      = 0x002050C
_DelVarArc       = 0x0021434
_CreateProtProg  = 0x0021334
_GetKey          = 0x0020D8C
kEnter           = 0x005

LlBrack          = 0x0C1
_DispHL_s        = 0x00207BC
_PutS            = 0x00207C0
_NewLine         = 0x00207F0
_ClrLCDFull      = 0x0020808
_HomeUp          = 0x0020828
_DispHL          = 0x0021EE0
ramStart         = 0x0D00000
buffer           = 0x0D03200
userMem          = 0x0D1A881
mpUsbRange       = 0x0E20000
mpIntRawStatus   = 0x0F00000
mpIntAck         = 0x0F00008

	;; Loading address, read by the linker script (ldscript).
	;; The Asm( header below precedes the code, which starts at userMem,
	;; hence the - 2.
	.globl __load_addr
__load_addr = userMem - 2

; Faraday USB 2.0 OTG Controller
caplength        = 0x0000
hciversion       = 0x0002
hcsparams        = 0x0004
hccparams        = 0x0008
usbcmd           = 0x0010
usbsts           = 0x0014
usbintr          = 0x0018
frindex          = 0x001C
periodiclistbase = 0x0024
asynclistaddr    = 0x0028
portsc           = 0x0030
miscr            = 0x0040
otgcsr           = 0x0080
otgisr           = 0x0084
otgier           = 0x0088
isr              = 0x00C0
imr              = 0x00C4
dev_ctrl         = 0x0100
dev_addr         = 0x0104
dev_test         = 0x0108
sof_fnr          = 0x010C
sof_mtr          = 0x0110
phy_tmsr         = 0x0114
cxfifo           = 0x0120
idle             = 0x0124
gimr             = 0x0130
gimr0            = 0x0134
gimr1            = 0x0138
gimr2            = 0x013C
gisr             = 0x0140
gisr0            = 0x0144
gisr1            = 0x0148
gisr2            = 0x014C
rxzlp            = 0x0150
txzlp            = 0x0154
isoeasr          = 0x0158
iep              = 0x0160
iep1             = 0x0160
iep2             = 0x0164
iep3             = 0x0168
iep4             = 0x016C
iep5             = 0x0170
iep6             = 0x0174
iep7             = 0x0178
iep8             = 0x017C
oep              = 0x0180
oep1             = 0x0180
oep2             = 0x0184
oep3             = 0x0188
oep4             = 0x018C
oep5             = 0x0190
oep6             = 0x0194
oep7             = 0x0198
oep8             = 0x019C
epmap            = 0x01A0
epmap1           = 0x01A0
epmap2           = 0x01A1
epmap3           = 0x01A2
epmap4           = 0x01A3
epmap5           = 0x01A4
epmap6           = 0x01A5
epmap7           = 0x01A6
epmap8           = 0x01A7
fifomap          = 0x01A8
fifomap0         = 0x01A8
fifomap1         = 0x01A9
fifomap2         = 0x01AA
fifomap3         = 0x01AB
fifocfg          = 0x01AC
fifocfg0         = 0x01AC
fifocfg1         = 0x01AD
fifocfg2         = 0x01AE
fifocfg3         = 0x01AF
fifocsr          = 0x01B0
fifocsr0         = 0x01B0
fifocsr1         = 0x01B4
fifocsr2         = 0x01B8
fifocsr3         = 0x01BC
dma_fifo         = 0x01C0
dma_ctrl         = 0x01C8
dma_addr         = 0x01CC
ep0_data         = 0x01D0

base             = rxzlp

        .byte 0x0EF, 0x07B


	di
	call	_ClrLCDFull
	call	_HomeUp
	call	dispStr
	.ascii "Press "
	.byte LlBrack
	.asciz "on] to abort."
	ld	(savesp), sp
	ld	ix, mpUsbRange + base
	ld	de, ack
	ld	hl, ackSize
	push	de
ackSend:
	call	dmaSend
	jr	nz, ackSend
	pop	de
	ld	l, 7
ackRecv:
	call	dmaRecv
	jr	nz, ackRecv
cmdLoop:
	call	pktRecv
	ld	a, d
	or	a, a
	jr	z, notIsReady
	cp	a, 0xAA
	call	nz, abort
	cpl
	cp	a, e
	call	nz, abort
handleIsReady:
	ld	a, l
	or	a, h
	call	nz, abort
	inc	a
	call	pktSendEmpty
	jr	cmdLoop
notIsReady:
	ld	a, e
	sub	2
	jp	z, cmdExit
	dec	a
	jr	z, cmdReqSize
	sub	2
	call	nz, abort
cmdReqBlk:
	ld	a, l
	xor	a, 4
	or	a, h
	call	nz, abort

	ld	bc, 0xFFFF
	ld	hl, buffer + 4
	ld	de, (hl)
	push	hl
	ld	hl, 0x400000
	sbc	hl, de
	sbc	hl, bc
	jr	c, _
	sbc	hl, hl
_:	add	hl, bc
	ex	de, hl
	ld	c, e
	ld	b, d
	call	repBlkLen
	pop	hl
	ex	de, hl
	or	a, a
	sbc	hl, bc
	inc	h
	dec	h
	jr	nz, resRepBlk
	add	hl, bc
	ld	c, l
	ld	b, h
	ex	de, hl
	ld	de, (hl)
	ex	de, hl
	push	bc
	ldir
	pop	de
	ld	a, 6
sendRes:
	call	pktSend
	jr	cmdLoop
resRepBlk:
	ex	de, hl
	ld	(hl), de
	inc	hl
	inc	hl
	ld	(hl), a
	ld	de, 3
	ld	a, 7
	jr	sendRes
cmdReqSize:
	ld	a, l
	or	a, h
	call	nz, abort
	ld	de, 0x400000 >> 8
	ld	hl, buffer + 5
	ld	(hl), de
	dec	hl
	ld	(hl), e
	ld	d, e
	ld	e, l
	jr	sendRes

dispStr:
	pop	hl
	call	_PutS
	push	hl
	jp	_NewLine

repBlkLen:
	ld	a, (hl)
	cpi
repBlkLenLoop:
	ret	po
	cpi
	jr	z, repBlkLenLoop
	dec	hl
	inc	bc
	ret

; === Packet Receive ===
; Receives an entire virtual packet.
; Output:
;  de = type
;  hl = size
pktRecv:
	ld	de, buffer
	ld	hl, 4
pktRecvHead:
	call	dmaRecv
	jr	nz, pktRecvHead
	push	hl
	ld.sis	hl, (buffer + 2 - ramStart)
	ld	c, e
pktRecvData:
	call	nz, dmaRecv
	ex	(sp), hl
	call	checkSum
	ex	(sp), hl
	ld	a, h
	or	a, l
	jr	nz, pktRecvData
	push	de
	ld	l, 2
pktRecvChk:
	call	dmaRecv
	jr	nz, pktRecvChk
	pop	hl
	ld	hl, (hl)
	pop	de
	or	a, a
	sbc.s	hl, de
	ld.sis	de, (buffer - ramStart)
	ld.sis	hl, (buffer + 2 - ramStart)
	ret	z
	call	dispStr
	.asciz "Checksum error!"
	call	abort

cmdExit:
	ld	a, l
	or	a, h
	call	nz, abort
	ld	a, 2
;	jr	pktSendEmpty

; === Packet Send ===
; Sends an entire virtual packet.
; Input:
;  a = cmd
;  ude = size
pktSendEmpty:
	ld	de, 0
pktSend:
	or	a, a
	sbc	hl, hl
	push	hl
	ld	hl, buffer + 3
	ld	(hl), d
	dec	hl
	ld	(hl), e
	dec	hl
	ld	(hl), 0
	dec	hl
	ld	(hl), a
	ex	de, hl
	inc	hl
	inc	hl
	inc	hl
	inc	hl
pktSendData:
	call	dmaSend
	ex	(sp), hl
	call	checkSum
	ex	(sp), hl
	ld	a, h
	or	a, l
	jr	nz, pktSendData
	pop	bc
	ex	de, hl
	ld	(hl), bc
	ex	de, hl
	ld	l, 2
pktSendChk:
	call	dmaSend
	ret	z
	jr	dmaSend

checkSum:
	push	de
	ld	a, c
checkSumLoop:
	ex	de, hl
	dec	hl
	ld	c, (hl)
	ex	de, hl
	add	hl, bc
	dec	a
	jr	nz, checkSumLoop
	pop	de
	ret

; === DMA Recv ===
; Receives up to uhl bytes from fifo0.
; Input:
;  ude = address of data to receive
;  uhl = total bytes to receive
;  uix = mpUsbRange + base
; Output:
;  ubc = bytes received
;  ude = address after data received
;  uhl = remaining bytes to receive
;  uix = mpUsbRange + base
dmaRecv:
	ld	(ix + dma_ctrl - base), 0
dmaRecvWait:
	call	check
	bit	0, (ix + gisr1 - base)
	jr	z, dmaRecvWait
	ld	bc, (ix + fifocsr0 - base)
	jr	dmaXfer

; === DMA Send ===
; Sends up to uhl bytes to fifo0.
; Input:
;  ude = address of data to send
;  uhl = total bytes to send
;  uix = mpUsbRange + base
; Output:
;  ubc = bytes sent
;  ude = address after data sent
;  uhl = remaining bytes to send
;  uix = mpUsbRange + base
dmaSend:
	ld	bc, 64
	ld	(ix + dma_ctrl - base), 2
dmaSendWait:
	call	check
	bit	0, (ix + gisr1 + 2 - base)
	jr	z, dmaSendWait
;	jr	dmaXfer

; === DMA Transfer ===
; Transfers min(ubc, uhl) bytes with fifo0.
; Input:
;  ubc = max bytes to transfer
;  ude = address of data to transfer
;  uhl = total bytes to transfer
;  uix = mpUsbRange + base
;  dma_ctrl = send << 1
; Output:
;  cf = true
;  zf = no more bytes to transfer
;  ubc = bytes transferred
;  ude = address after data transferred
;  uhl = remaining bytes to transfer
;  uix = mpUsbRange + base
dmaXfer:
	or	a, a
	sbc	hl, bc
	jr	c, dmaXferLast
	ld	(ix + dma_fifo - base), 1 << 0
	ld	(ix + dma_ctrl + 1 - base), bc
	ld	(ix + dma_addr - base), de
	set	0, (ix + dma_ctrl - base)
	ex	de, hl
	add	hl, bc
	ex	de, hl
dmaXferWait:
	call	check
	ld	a, (ix + gisr2 + 1 - base)
	rrca
	call	c, abort
	ld	a, (ix + gisr2 - base)
	rlca
	jr	nc, dmaXferWait
	ld	(ix + dma_fifo - base), 0
	ret
dmaXferLast:
	or	a, a
	adc	hl, bc
	ret	z
;	ld	b, h
	ld	c, l
	jr	dmaXfer

; === Check For Abort ===
; Aborts if the on key has been pressed.
; Output:
;  cf = false
;  a = ?
check:	bit	0, (ix + gisr2 - base)
	jr	nz, abort
	ld	a, (mpIntRawStatus)
	rrca
	ret	nc
	call	waitOnRelease
abort:	xor	a, a
	ld	(mpUsbRange + dma_fifo), a
	ld	hl, mpUsbRange + usbcmd
	set	1, (hl)
	call	dispStr
	.asciz "Unknown USB Error."
	pop	hl
	call	_DispHL
	call	_NewLine
	ld	hl, (mpUsbRange + usbintr)
	call	_DispHL
	call	_NewLine
	ld	hl, (mpUsbRange + otgisr)
	call	_DispHL
	call	_NewLine
	ld	hl, (mpUsbRange + gisr0)
	call	_DispHL
	call	_NewLine
	ld	hl, (mpUsbRange + gisr1)
	call	_DispHL
	call	_NewLine
	ld	hl, (mpUsbRange + gisr2)
	call	_DispHL
	call	_NewLine
exit:	ld	sp, 0
savesp = $ - 3
	ret

; === Wait For On Release ===
; Returns when the on key has been released.
waitOnRelease:
	ld	hl, 1 << 8 | mpIntRawStatus
waitOnReleaseLoop:
	ld	l, mpIntAck & 0x0FF
	ld	(hl), h
	ld	l, mpIntRawStatus & 0x0FF
	bit	0, (hl)
	jr	nz, waitOnReleaseLoop
	ret

ack: .byte 0, 0, 0, 7, 4, 0, 0, 0, 1, 0x0AA, 0, 1
ackSize = . - ack
