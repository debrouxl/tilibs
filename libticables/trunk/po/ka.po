#: src/bsd/detect.cc:135 src/linux/detect.cc:176 src/macos/detect.cc:135
#, c-format
msgid "can't open '%s'."
msgstr "'%s'-ის გახსნის შეცდომა."

#: src/bsd/detect.cc:169 src/linux/detect.cc:210 src/macos/detect.cc:169
#, c-format
msgid "    node %s: exists"
msgstr "    კვანძი %s: არსებობს"

#: src/bsd/detect.cc:173 src/linux/detect.cc:214 src/macos/detect.cc:173
#, c-format
msgid "    node %s: does not exist"
msgstr "    კვანძი %s: არ არებობს"

#: src/bsd/detect.cc:174 src/linux/detect.cc:215 src/macos/detect.cc:174
msgid "    => you will have to create the node."
msgstr "    => ეს კვანძი უნდა შექმნათ."

#: src/bsd/detect.cc:181 src/linux/detect.cc:222
#, c-format
msgid "    node %s: accessible"
msgstr "    კვანძი %s: წვდომადია"

#: src/bsd/detect.cc:188 src/linux/detect.cc:229 src/macos/detect.cc:182
#, c-format
msgid "    permissions/user/group:%s%s %s"
msgstr "    წვდომები/მომხმარებელი/ჯგუფი:%s%s %s"

#: src/bsd/detect.cc:201 src/linux/detect.cc:242 src/macos/detect.cc:195
msgid "    user can r/w on device: yes"
msgstr "    მომხმარებელს შეუძლია მოწყობილობაზე ჩაწ/წაკით: დიახ"

#: src/bsd/detect.cc:202 src/bsd/detect.cc:243 src/linux/detect.cc:243
#: src/linux/detect.cc:284
msgid "    => device is inaccessible for unknown reasons"
msgstr "    => მოწყობილობა ხელმიუწვდომელია უცნობი მიზეზით"

#: src/bsd/detect.cc:207 src/linux/detect.cc:248 src/macos/detect.cc:200
msgid "    user can r/w on device: no"
msgstr "    მომხმარებელს შეუძლია მოწყობილობაზე ჩაწ/წაკით: არა"

#: src/bsd/detect.cc:212 src/linux/detect.cc:253 src/macos/detect.cc:205
msgid "    others can r/w on device: yes"
msgstr "    სხვებს შეუძლიათ მოწყობილობაზე ჩაწ/წაკით: დიახ"

#: src/bsd/detect.cc:218 src/linux/detect.cc:259 src/macos/detect.cc:211
msgid "    others can r/w on device: no"
msgstr "    სხვებს შეუძლიათ მოწყობილობაზე ჩაწ/წაკით: არა"

#: src/bsd/detect.cc:225 src/linux/detect.cc:266 src/macos/detect.cc:218
#, c-format
msgid "    is the user '%s' in the group '%s': yes"
msgstr "    არის მომხმარებელი '%s' ჯგუფში '%s': დიახ"

#: src/bsd/detect.cc:230 src/linux/detect.cc:271 src/macos/detect.cc:223
#, c-format
msgid "    is the user '%s' in the group '%s': no"
msgstr "    არის მომხმარებელი '%s' ჯგუფში '%s': არა"

#: src/bsd/detect.cc:231 src/linux/detect.cc:272 src/macos/detect.cc:224
#, c-format
msgid "    => you should add your username at the group '%s' in '/etc/group'"
msgstr ""
"    => დაამატეთ თქვენი მომხმარებლის სახელი ჯგუფში '%s' ფაილში '/etc/group'"

#: src/bsd/detect.cc:232 src/linux/detect.cc:273 src/macos/detect.cc:225
msgid "    => you will have to restart your session, too"
msgstr "    => ასევე მოგიწევთ, სესია თავიდან გაუშვათ"

#: src/bsd/detect.cc:251 src/linux/detect.cc:292 src/macos/detect.cc:243
#, c-format
msgid "Check for super-user access: %s"
msgstr "ზემომხმარებლის წვდომის შემოწმება: %s"

#: src/bsd/detect.cc:261 src/linux/detect.cc:306
msgid "Check for tty support:"
msgstr "tty-ის მხარდაჭერის შემოწმება:"

#: src/bsd/detect.cc:262 src/linux/detect.cc:308
msgid "    tty support: available."
msgstr "    tty-ის მხარდაჭერა: ხელმისაწვდომია."

#: src/bsd/detect.cc:265 src/linux/detect.cc:315 src/macos/detect.cc:251
msgid "Check for tty usability:"
msgstr "tty-ის გამოყენებადობის შემოწმება:"

#: src/bsd/detect.cc:277 src/linux/detect.cc:339 src/linux/detect.cc:386
msgid "    is usable: yes"
msgstr "    გამოყენებადია: დიახ"

#: src/bsd/detect.cc:290 src/linux/detect.cc:404 src/macos/detect.cc:265
msgid "Check for libusb support:"
msgstr "libusb-ის მხარდაჭერის შემოწმება:"

#: src/bsd/detect.cc:292 src/linux/detect.cc:406 src/macos/detect.cc:267
msgid "    usb support: available."
msgstr "    usb-ის მხარდაჭერა: ხელმისაწვდომია."

#: src/bsd/detect.cc:295 src/linux/detect.cc:408 src/macos/detect.cc:270
msgid "    usb support: not compiled."
msgstr "    USB-ის მხარდაჭერა: არ ჩართულა აგებისას."

#: src/error.cc:67
msgid "Msg: link cable is busy."
msgstr "შეტყ: კავშირის კაბელი დაკავებულია."

#: src/error.cc:69
msgid "Cause: a transfer is in progress."
msgstr "მიზეზი: მიმდინარეობს გადაცემა."

#: src/error.cc:75
msgid "Msg: unable to use parallel/serial port: access refused."
msgstr ""
"შეტყ: პარალელური/სერიული პორტის გამოყენება შეუძლებელია: წვდომა აკრძალულია."

#: src/error.cc:77
msgid "Cause: you are not running program as root or setuid root."
msgstr "მიზეზი: პროგრამა root-ით, ან setuid root-ით არაა გაშვებული."

#: src/error.cc:83
msgid "Msg: unable to use serial (/dev/ttySx) device."
msgstr "შეტყ: სერიული (/dev/ttySx) მოწყობილობის გამოყენება შეუძლებელია."

#: src/error.cc:85
msgid ""
"Cause: the /dev/ttySx node doesn't exist or you don't have required "
"permissions. How to grant permission to devices to the user depends on the "
"distribution, it may involve adding the user to a group such as 'dialout' or "
"'uucp'. This can be done by editing /etc/group and add the username after "
"the ':'. Example: dialout:x:20:romain "
msgstr ""
"მიზეზი: კვანძები /dev/ttySx არ არსებობს, ან მასზე წვდომა არ გაგაჩნიათ. როგორ "
"მიიღოთ წვდომები ამ მოწყობილობებთან თქვენი მომხმარებლით, დამოკიდებულია "
"დისტრიბუტივზე. ის შეიძლება, შეიცავდეს მომხმარებლის ჩამატებას ისეთი ჯგუფებში, "
"როგორიცაა 'dialout', ან 'uucp'. ამიის გაკეთება /etc/group ფაილის ცასწორებით "
"და მომხმარებლის ':'-ის შემდეგ ჩამატებით შეგიძლიათ: მაგ: dialout:x:20:romain "

#: src/error.cc:97
msgid "Msg: unable to use parport (/dev/parportX) device."
msgstr "შეტყ: პარალელური (/dev/partportX) მოწყობილობის გამოყენება შეუძლებელია."

#: src/error.cc:99
msgid ""
"Cause: the /dev/parportX node doesn't exist or you don't have required "
"permissions. How to grant permission to devices to the user depends on the "
"distribution, it may involve adding the user to a group such as 'lp'. This "
"can be done by editing /etc/group and add the username after the ':'. "
"Example: lp:x:7:romain "
msgstr ""
"მიზეზი: კვანძები /dev/parportX არ არსებობს, ან მასზე წვდომები არ გაქვთ. ის "
"თუ როგორ უნდა მიანიჭოთ ეს წვდომა მომხმარებელს, დისტრიბუტივზეა დამოკიდებული. "
"შეიძლება, დაგჭირდეთ თქვენი მომხმარებლის ჩამატება ისეთ ჯგუფში, როგორიცაა "
"'lp'. ამისი გაკეთება /etc/group ფაილის ჩასწორებით და მომხმარებლის ':' "
"სიმბოლოს შემდეგ დამატებით შეგიძლიათ. მაგ: lp:x:7:romain "

#: src/error.cc:111
msgid "Msg: unable to use USB pseudo file system."
msgstr "შეტყ: USB-ის ფსევდოფაილური სისტემის გამოყენება შეუძლებელია."

#: src/error.cc:113
msgid ""
"Cause: the USB filesystem is not mounted or cannot access USB device because "
"current user doesn't have the necessary permissions. How to grant permission "
"to devices to the user depends on the distribution; it may involve adding "
"udev and/or pam_console configuration files, and you may in addition have to "
"add your user to a group such as 'usb' or set-up libusb mounting "
"parameters.If packages of TiLP and its libraries for your distribution "
"exist, it is recommended to use those, as everything which can be configured "
"automatically will be set up for you. Otherwise, manual setup steps, if any, "
"are explained in the CONFIG file shipped with the ticables2 library. "
msgstr ""
"მიზეზი: USB-ის ფაილური სისტემა მიმაგრებული არაა, ან წვდომა USB "
"მოწყობილობასთან შეუძლებელია იმიტომ, რომ მიმდინარე მომხმარებელს საჭირო "
"წვდომები არ გააჩნია. ის, თუ როგორ უნდა მიანიჭოთ მომხმარებელს ეს წვდომა, "
"დისტრიბუტივზეა დამოკიდებული. შეიძლება, დაგჭირდეთ udev ან/და pam_console-ის "
"კონფიგურაციის ფაილების ჩასწორება, ან, დამატებით, ისეთ ჯგუფში ჩასმა თქვენი "
"მომხმარებლის, როგორიცაა 'usb'. ან, მოირგეთ libusb-ის მიმაგრების "
"პარამეტრები.თუ TiLP-ის პაკეტები და მისი ბიბლიოთეკები უკვე არსებობს თქვენი "
"დისტრიბუტივისთვის, რეკომენდებულია, ისინი გამოიყენოთ, რადგან ისინი ამ "
"ყველაფერს ავტომატურად იზამენ. სხვა შემთხვევაში, ხელით მორგების ნაბიჯები "
"აღწერილია CONFIG ფაილში, რომელიც ticables2 ბიბლიოთეკას მოჰყვება. "

#: src/error.cc:130
msgid "Msg: illegal operation or argument."
msgstr "შეტყ: მიუღებელი ოპერაცია, ან არგუმენტი."

#: src/error.cc:132
msgid ""
"Cause: the program which uses this library is buggy. Fire-up the developer!"
msgstr ""
"მიზეზი: პროგრამა, რომელიც ამ ბიბლიოთეკას იყენებს, შეცდომებს შეიცავს. "
"პროგრამისტი გამაიყვანეთ!"

#: src/error.cc:138
msgid "Msg: DhaHelper driver and/or library not found."
msgstr "შეტყ: DhaHelper-ის დრაივერი ან/და ბიბლიოთეკა აღმოჩენილი არაა."

#: src/error.cc:140 src/error.cc:148
msgid ""
"Cause: the driver may have been not started yet; it may have been "
"uninstalled; the library has been installed without administrator privileges."
msgstr ""
"მიზეზი: შეიძლება, დრაივერი ჯერ კიდევ გაშვებული არაა. ან შეიძლება, ის "
"წაშალეს, ან ბიბლიოთეკა ადმინისტრატორის უფლებების გარეშე იქნა დაყენებული."

#: src/error.cc:146
msgid "Msg: RwPorts driver and/or library not found."
msgstr "შეტყ: RwPorts-ის დრაივერი ან/და ბიბლიოთეკა აღმოჩენილი არაა."

#: src/error.cc:154
msgid "Msg: error occurred while writing to the device."
msgstr "შეტყ: მოწყობილობაში ჩაწერისას აღმოჩენილია შეცდომა."

#: src/error.cc:159
msgid "Msg: timeout occurred while writing to the device."
msgstr "შეტყ: მოწყობილობაში ჩაწერისას მოლოდინის ვადა ამოიწურა."

#: src/error.cc:161 src/error.cc:174
msgid "Cause: check that link cable is plugged and/or the calculator is ready."
msgstr ""
"მიზეზი: შეამოწმეთ, მიერთებულია თუ არა კავშირის კაბელი ან/და რომ კალკულატორი "
"მზადაა."

#: src/error.cc:167
msgid "Msg: error occurred while reading from the device."
msgstr "შეტყ: მოწყობილობიდან წაკითხვისას აღმოჩენილია შეცდომა."

#: src/error.cc:172
msgid "Msg: timeout occurred while reading from the device."
msgstr "შეტყ: მოწყობილობიდან წაკითხვისას მოლოდინის ვადა ამოიწურა."

#: src/error.cc:180
msgid "Msg: the probing of device failed."
msgstr "შეტყ: მოწყობილობის ზონდირება ჩავარდა."

#: src/error.cc:182
msgid "Cause: internal error. If you get it, this is a bug!"
msgstr "მიზეზი: შიდა შეცდომა. თუ ეს ნახეთ, ესე იგი, კოდში შეცდომაა!"

#: src/error.cc:195
msgid "Msg: unable to open serial port."
msgstr "შეტყ: სერიული პორტის გახსნა შეუძლებელია."

#: src/error.cc:197
msgid "Cause: check that device is not used/locked by another application."
msgstr ""
"მიზეზი: შეამოწმეთ, ხომ არ გამოიყენება/დაბლოკა მოწყობილობა სხვა აპლიკაციამ."

#: src/error.cc:205
msgid "Msg: failed to get VTI handle."
msgstr "შეტყ: VTI-ის დამმუშავებლის მიღება ჩავარდა."

#: src/error.cc:207
msgid "Cause: VTI may not be running. VTI must be launched before."
msgstr "მიზეზი: შეიძლება, VTI გაშვებული არაა. VTI მანამდე უნდა გაუშვათ."

#: src/error.cc:217
msgid "Msg: unable to get a unique IPC (Inter Process Communication) key."
msgstr ""
"შეტყ: უნიკალური IPC-ის (პროცესთაშორისი კომუნიკაციის) გასაღების მიღება "
"შეუძლებელია."

#: src/error.cc:219
msgid ""
"Cause: check that you have enough resources for allocating a shared memory "
"segment."
msgstr ""
"მიზეზი: დარწმუნდით, რომ გაქვთ საკმარისი რესურსები გაზიარებული მეხსიერების "
"სეგმენტის გამოსაყოფად."

#: src/error.cc:226
msgid "Msg: unable to open/close pipes for virtual linking."
msgstr ""
"შეტყ: ვირტუალური კავშირისთვის კომუნიკაციის არხის გახსნა/დახურვა შეუძლებელია."

#: src/error.cc:228
msgid ""
"Cause: check that you have permissions to create a pipe in the /tmp "
"directory."
msgstr ""
"მიზეზი: შეამოწმეთ, გაქვთ, თუ არა წვდომა, შექმნათ საკომუნიკაციო არხი "
"საქაღალდეში /tmp."

#: src/error.cc:235
msgid "Msg: unable to open serial device."
msgstr "შეტყ: სერიული მოწყობილობის გახსნა შეუძლებელია."

#: src/error.cc:237 src/error.cc:246
msgid ""
"Cause: check that you have permissions on /dev/ttySx device. Check that "
"device is not locked."
msgstr ""
"მიზეზი: შეამოწმეთ, გაქვთ, თუ არა წვდომები მოწყობილობაზე /dev/ttySx. "
"დარწმუნდით, რომ მოწყობილობა დაბლოკილი არაა."

#: src/error.cc:244
msgid "Msg: unable to issue a specific command on serial device."
msgstr "შეტყ: სერიულ მოწყობილობაზე სპეციფიკური ბრძანების გაგზავნა შეუძლებელია."

#: src/error.cc:252
msgid "Msg: unable to open parallel device."
msgstr "შეტყ: პარალელური მოწყობილობის გახსნა შეუძლებელია."

#: src/error.cc:254 src/error.cc:262
msgid ""
"Cause: check that you have permissions on /dev/parportX device. Check that "
"device is not locked."
msgstr ""
