#, c-format
msgid "%s: -L requires a shell."
msgstr "%s: -L nécessite un shell."

#: ../src/squish.cc:563
#, c-format
msgid ""
"%s: -L cannot be combined with -s %s, whose header carries no description."
msgstr ""
"%s: -L ne peut pas être combiné avec -s %s, dont l'en-tête ne comporte pas "
"de description."

#: ../src/squish.cc:581 ../src/squish.cc:971
#, c-format
