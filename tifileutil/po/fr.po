msgstr "%s: fichier à entrées multiples non pris en charge."

#: ../src/squish.cc:587 ../src/squish.cc:1027
#, c-format
msgid "%s: variable type 0x%02X is not a program type."
msgstr "%s: le type de variable 0x%02X n'est pas un type de programme."

#: ../src/squish.cc:613
#, c-format
msgid ""
"%s: the TI-73 nostub program contains squished binary data, not hex text."
msgstr ""
"%s: le programme nostub TI-73 contient des données binaires comprimées, pas "
"du texte hexadécimal."

#: ../src/squish.cc:621
#, c-format
msgid "%s: odd number of hex digits."
msgstr "%s: nombre impair de chiffres hexadécimaux."

#: ../src/squish.cc:635
#, c-format
msgid "%s: non-hexadecimal data at offset %u."
msgstr "%s: données non hexadécimales au décalage %u."

#: ../src/squish.cc:759
#, c-format
msgid ""
"%s: %u bytes of binary data are too large for the TI-73 nostub format (max "
"999 bytes)."
msgstr ""
"%s: %u octets de données binaires dépassent la limite du format nostub TI-73 "
"(999 octets maximum)."

#: ../src/squish.cc:763
#, c-format
msgid ""
"%s: %u bytes of binary data are larger than the 900-byte limit of the TI-73 "
"OS, the nostub program may not run."
msgstr ""
"%s: %u octets de données binaires dépassent la limite de 900 octets de l'OS "
"TI-73, le programme nostub risque de ne pas fonctionner."

#: ../src/squish.cc:874
#, c-format
msgid "%s: wrote %u bytes of binary data to %s."
msgstr "%s: %u octets de données binaires écrits dans %s."

#: ../src/squish.cc:988
#, c-format
msgid "%s: no 0xF3 tag found, the Exec string is unlikely to work."
msgstr ""
"%s: tag 0xF3 non trouvé, la chaîne Exec ne fonctionnera probablement pas."

#: ../src/squish.cc:992
#, c-format
msgid "%s: %s is too short to be a valid ASM file."
msgstr "%s: %s est trop court pour être un fichier ASM valide."

#: ../src/squish.cc:1014
#, c-format
msgid "%s: wrote Exec string to %s."
msgstr "%s: chaîne Exec écrite dans %s."

#: ../src/squish.cc:1128
#, c-format
msgid "%s: wrote %u bytes of hex data to %s."
msgstr "%s: %u octets de données hexadécimales écrits dans %s."

#: ../src/wrap.cc:269
#, c-format
msgid "%s: no variable type specified."
msgstr "%s: type de variable non spécifié."

#: ../src/wrap.cc:285 ../src/wrap.cc:293
#, c-format
msgid "%s: invalid variable type %s."
msgstr "%s: type de variable invalide %s."

#: ../src/wrap.cc:300
#, c-format
msgid "%s: -P cannot be combined with -p, -C or -r."
msgstr "%s: -P ne peut pas être combiné avec -p, -C ou -r."

#: ../src/wrap.cc:306
#, c-format
msgid "%s: -P requires a TI-eZ80 model."
msgstr "%s: -P nécessite un modèle TI-eZ80."

#: ../src/wrap.cc:578
#, c-format
msgid ""
"%s: input data too small or too large for a TI-68k picture (max 3090 bytes)."
msgstr ""
"%s: données d'entrée trop petites ou trop grandes pour une image TI-68k (max "
"3090 octets)."

#: ../src/wrap.cc:688
#, c-format
msgid "%s: Python AppVar size field (%u) differs from actual data length (%u)."
msgstr ""
"%s: le champ taille de l'AppVar Python (%u) et la vraie taille des données "
"(%u) sont différents."

#: ../src/wrap.cc:754
#, c-format
msgid "%s: squished program, no name prefix to strip."
msgstr "%s: programme \"squished\", aucun préfixe de nom à enlever."

#: ../src/wrap.cc:764
#, c-format
msgid "%s: no tokenized name prefix found, passing data through."
msgstr "%s: aucun préfixe tokenisé de nom trouvé, on renvoie les données."

#: ../src/wrap.cc:780
#, c-format
msgid "%s: no 0xF3 tag found, passing the last byte through."
msgstr "%s: tag 0xF3 non trouvé, on laisse passer le dernier octet."

#: ../src/wrap.cc:791
#, c-format
msgid "%s: string size field (%u) differs from actual data length (%u)."
msgstr ""
"%s: le champ taille de la chaîne (%u) et la vraie taille des données (%u) "
"sont différents."

#: ../src/wrap.cc:798
#, c-format
msgid "%s: no leading 0x00 byte found, passing data through."
msgstr "%s: premier octet 0x00 non trouvé, on renvoie les données."

#: ../src/wrap.cc:804
#, c-format
msgid "%s: no STR_TAG (0x2D) found, passing the trailing bytes through."
msgstr "%s: tag STR_TAG (0x2D) non trouvé, on laisse passer les octets de fin."

#: ../src/wrap.cc:816
#, c-format
msgid "%s: other data size field (%u) differs from actual data length (%u)."
msgstr ""
"%s: le champ taille des autres données (%u) et la vraie taille des données "
"(%u) sont différents."

#: ../src/wrap.cc:828
#, c-format
msgid "%s: no OTH_TAG (0xF8) found, passing the trailing bytes through."
msgstr "%s: tag OTH_TAG (0xF8) non trouvé, on laisse passer les octets de fin."

#: ../src/wrap.cc:842
#, c-format
msgid "%s: text size field (%u) differs from actual data length (%u)."
msgstr ""
"%s: le champ taille du texte (%u) et la vraie taille des données (%u) sont "
"différents."

#: ../src/wrap.cc:852
#, c-format
msgid "%s: no TEXT_TAG (0xE0) found, passing the last byte through."
msgstr "%s: tag TEXT_TAG (0xE0) non trouvé, on laisse passer le dernier octet."

#: ../src/wrap.cc:867
#, c-format
msgid "%s: unknown text line type 0x%02X."
msgstr "%s: type de ligne de texte inconnu 0x%02X."

#: ../src/wrap.cc:882
#, c-format
msgid "%s: trailing bytes after the end-of-file delimiter."
msgstr "%s: octets de fin après le délimiteur de fin de fichier."

#: ../src/wrap.cc:898
#, c-format
msgid "%s: picture size field (%u) differs from actual data length (%u)."
msgstr ""
"%s: le champ taille de l'image (%u) et la vraie taille des données (%u) sont "
"différents."

#: ../src/wrap.cc:911
#, c-format
msgid "%s: no PIC_TAG (0xDF) found, passing the last byte through."
msgstr "%s: tag PIC_TAG (0xDF) non trouvé, on laisse passer le dernier octet."

#: ../src/wrap.cc:914
#, c-format
msgid "%s: bitmap length (%u) differs from height*ceil(width/8) (%u)."
msgstr ""
"%s: la longueur du bitmap (%u) diffère de hauteur*plafond(largeur/8) (%u)."

#. Not a Python AppVar payload: pass the data through.
#: ../src/wrap.cc:925
#, c-format
msgid "%s: not a Python AppVar payload, passing data through."
msgstr ""
"%s: ce n'est pas une charge utile d'AppVar Python, on renvoie les données."

#: ../src/wrap.cc:935
#, c-format
msgid "%s: malformed Python AppVar payload."
msgstr "%s: charge utile d'AppVar Python mal formée."

#: ../src/wrap.cc:1036
#, c-format
msgid "%s: cannot seek in input file."
msgstr "%s: ne peut pas se positionner dans le fichier d'entrée."

#: ../src/wrap.cc:1043
#, c-format
msgid "%s: input file too large."
msgstr "%s: fichier d'entrée trop grand."

#: ../src/wrap.cc:1072 ../src/wrap.cc:1121 ../src/wrap.cc:1134
#, c-format
msgid "%s: unable to write the entire output."
msgstr "%s: impossible d'écrire toute la sortie."

#: ../src/wrap.cc:1081
#, c-format
msgid "%s: %s is not a regular TI file."
msgstr "%s: %s n'est pas un fichier TI ordinaire."

#: ../src/wrap.cc:1105
#, c-format
msgid "%s: multi-entry file, unwrapping assumes a single entry."
msgstr ""
"%s: fichier à entrées multiples, le déballage (unwrap) suppose une entrée "
"unique."

#: ../src/wrap.cc:1142
#, c-format
msgid "%s: wrote %lu bytes."
msgstr "%s: %lu octets écrits."
