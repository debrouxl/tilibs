msgstr "%s: nom long non terminé, on le laisse passer."

#: ../src/squish.cc:509
#, c-format
msgid ""
"%s: unknown shell %s (expected TI-82: crash, ace, ash, sng; TI-73: mallard, "
"nostub; TI-83: ion, ashell, venus, ion83, pse83, ice, sos; TI-83+/84+/CSE/"
"CE: ion, ion83, pse83, ice, tse, mirage)."
msgstr ""
"%s: shell %s inconnu (attendu pour TI-82: crash, ace, ash, sng ; pour TI-73: "
"mallard, nostub ; pour TI-83: ion, ashell, venus, ion83, pse83, ice, sos ; "
"pour TI-83+/84+/CSE/CE: ion, ion83, pse83, ice, tse, mirage)."

#: ../src/squish.cc:517 ../src/squish.cc:1022
#, c-format
msgid "%s: %s is not a supported TI-Z80 file."
msgstr "%s: %s n'est pas un fichier TI-Z80 pris en charge."

#: ../src/squish.cc:528
#, c-format
msgid "%s: the %s shell is for TI-73/83/83+, not TI-82."
msgstr "%s: le shell %s est pour TI-73/83/83+, pas pour TI-82."

#: ../src/squish.cc:535
#, c-format
msgid "%s: the %s shell is for TI-82, TI-73 or TI-83+, not TI-83."
msgstr "%s: le shell %s est pour TI-82, TI-73 ou TI-83+, pas pour TI-83."

#: ../src/squish.cc:544
#, c-format
msgid "%s: the %s shell is for TI-82, TI-83 or TI-83+, not TI-73."
msgstr "%s: le shell %s est pour TI-82, TI-83 ou TI-83+, pas pour TI-73."

#: ../src/squish.cc:553
#, c-format
msgid "%s: the %s shell is for TI-82, TI-73 or TI-83, not this model."
msgstr "%s: le shell %s est pour TI-82, TI-73 ou TI-83, pas pour ce modèle."

