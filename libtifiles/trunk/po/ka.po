#: src/error.cc:58
msgid "Msg: unable to allocate memory (malloc)."
msgstr "შეტყ: მეხსიერების გამოყოფის შეცდომა (malloc)."

#: src/error.cc:60
msgid "Cause: memory too low ?"
msgstr "მიზეზი: მეხსიერება ცოტაღაა ?"

#: src/error.cc:66
msgid "Msg: unable to open file."
msgstr "შეტყ: ფაილის გახსნა შეუძლებელია."

#: src/error.cc:68 src/error.cc:76
msgid "Cause: either the file does not exist, either there is no room."
msgstr "მიზეზი: ან ფაილი არ არსებობს, ან ადგილი არაა."

#: src/error.cc:74
msgid "Msg: unable to close file."
msgstr "შეტყ: ფაილის დახურვა შეუძლებელია."

#: src/error.cc:82
msgid "Msg: the size of a group file cannot exceed 64 KB."
msgstr "შეტყ: ჯგუფის ფაილის ზომა არ შეიძლება, 64კბ-ს აჭარბებდეს."

#: src/error.cc:84
msgid "Cause: too many variables/data."
msgstr "მიზეზი: მეტისმეტად ბევრი ცვლადი/მონაცემები."

#: src/error.cc:90
msgid "Msg: unknown calculator type."
msgstr "შეტყ: უცნობი კალკულატორის ტიპი."

#: src/error.cc:92
msgid "Cause: probably due to a bug, mail to: tilp-users@lists.sf.net."
msgstr "მიზეზი: ალბათ შეცდომის გამო. მოგვწერეთ: tilp-users@lists.sf.net."

#: src/error.cc:99
msgid "Msg: invalid file."
msgstr "შეტყ: არასწორი ფაილი."

#: src/error.cc:101
msgid "Cause: it's probably not a TI formatted file."
msgstr "მიზეზი: ეს ფაილი, ალბათ, TI-ის ფორმატში არაა."

#: src/error.cc:107
msgid "Msg: checksum error."
msgstr "შეტყ: საკონტროლო ჯამის შეცდომა."

#: src/error.cc:109
msgid "Cause: the file has an incorrect checksum and may be corrupted."
msgstr "მიზეზი: ფაილის საკონტროლო ჯამი არასწორია და შეიძლება, ის დაზიანებულია."

#: src/error.cc:115
msgid "Msg: (Un)Zip error."
msgstr "შეტყ: Zip-ში ჩადების/ამოღების შეცდომა."

#: src/error.cc:117
msgid "Cause: unknown..."
msgstr "მიზეზი: უცნობია..."

#: src/error.cc:123
msgid "Msg: unsupported function."
msgstr "შეტყ: მხარდაუჭერელი ფუნქცია."

#: src/error.cc:125
msgid "Cause: the function you attempted to use is not available."
msgstr "მიზეზი: ფუნქცია, რომლის გამოყენებაც სცადეთ, ხელმისაწვდომი არაა."

#: src/error.cc:131
msgid "Msg: I/O file error."
msgstr "შეტყ: შეტანა/გამოტანის შეცდომა."

#: src/error.cc:133
msgid "Cause: file is corrupted or invalid."
msgstr "მიზეზი: ფაილი დაზიანებული, ან არასწორია."

#: src/error.cc:139
msgid "Msg: invalid parameter."
msgstr "შეტყ: არასწორი პარამეტრი."

#: src/error.cc:141
msgid "Cause: the program which uses this library is buggy. Fire-up the developer!"
msgstr "მიზეზი: პროგრამა, რომელიც ამ ბიბლიოთეკას იყენებს, შეცდომებს შეიცავს. პროგრამისტი გამაიყვანეთ!"

